/* ---- Helpers: node option rendering (met "Ik weet het niet" auto-append) ---- */
function buildOptionButton(label, i, isWeetNiet, handler){
  const b=document.createElement('button'); b.type='button';
  b.className = 'answer' + (isWeetNiet?' weet-niet':'');
  const letter = isWeetNiet ? '?' : String.fromCharCode(65+i);
  const L = subst(label);
  b.innerHTML = `<span class="key" aria-hidden="true">${letter}</span><span>${L}</span>`;
  /* De letter staat visueel in de knop; screenreaders krijgen alleen het label. */
  b.setAttribute('aria-label', plat(L));
  if(!isWeetNiet) b.dataset.key = letter;
  b.addEventListener('click', handler);
  return b;
}

/* ---- Sneltoetsen A/B/C: de letters op de knoppen zijn nu echte sneltoetsen ---- */
document.addEventListener('keydown', e=>{
  if(e.ctrlKey||e.metaKey||e.altKey) return;
  if(el('weetNiet').open) return;
  const t=e.target;
  if(t && (t.tagName==='INPUT'||t.tagName==='TEXTAREA'||t.isContentEditable)) return;
  const container = state.screen==='triage' ? el('triageAnswers') : state.screen==='flow' ? el('answers') : null;
  if(!container) return;
  const k = e.key.toUpperCase();
  if(k==='?'){ const w=container.querySelector('.answer.weet-niet'); if(w){ e.preventDefault(); w.click(); } return; }
  if(!/^[A-Z]$/.test(k)) return;
  const btn = container.querySelector(`.answer[data-key="${k}"]`);
  if(btn){ e.preventDefault(); btn.click(); }
});

/* ---- Triage ---- */
function startTriage(){
  state.catKey=null; state.history=[]; state.triageHistory=[]; state.triageNode=TRIAGE.start; state.lastResult=null;
  document.body.classList.remove('has-result');
  renderTriage(); show('triage'); updateUrl(true);
}
function renderTriage(){
  const node=TRIAGE.nodes[state.triageNode];
  el('triageText').innerHTML=subst(node.vraag);
  el('triageHelp').innerHTML=subst(node.help||'');
  el('triageHelp').style.display=node.help?'block':'none';
  const ans=el('triageAnswers'); ans.innerHTML='';
  node.opties.forEach((opt,i)=>{
    ans.appendChild(buildOptionButton(opt.label, i, false, ()=>triageChoose(opt)));
  });
  ans.appendChild(buildOptionButton('Ik weet het niet — help me kiezen', 0, true, ()=>showWeetNiet('wegwijzer')));
  el('triageBackBtn').style.display = state.triageHistory.length? '':'none';
  announce('Vraag: '+plat(node.vraag));
  focusKop('triageText');
}
function triageChoose(opt){
  /* cat + result: de wegwijzer weet het antwoord al, dus geen overbodige vervolgvraag. */
  if(opt.cat && opt.result){
    state.catKey=opt.cat; state.history=[]; state.nodeKey=CATEGORIES[opt.cat].start; state.lastResult=opt.result;
    document.body.classList.remove('has-result');
    renderResult(opt.result); show('result'); updateUrl(true); return;
  }
  if(opt.cat){ startCategory(opt.cat, opt.node); return; }
  if(opt.next){ state.triageHistory.push(state.triageNode); state.triageNode=opt.next; renderTriage(); }
}
el('triageBackBtn').addEventListener('click', ()=>{ const p=state.triageHistory.pop(); if(p){ state.triageNode=p; renderTriage(); } });

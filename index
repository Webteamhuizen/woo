/* ---- Question flow ---- */
function startCategory(key, startNode){
  state.catKey=key; state.history=[]; state.nodeKey=startNode || CATEGORIES[key].start; state.lastResult=null;
  document.body.classList.remove('has-result');
  renderNode(); show('flow'); updateUrl(true);
}
function renderNode(){
  const cat=CATEGORIES[state.catKey];
  const node=cat.nodes[state.nodeKey];
  el('progress').textContent=`${plat(cat.naam)} · art. ${cat.art} · vraag ${state.history.length+1}`;
  el('qText').innerHTML=subst(node.vraag);
  el('qHelp').innerHTML=subst(node.help||'');
  el('qHelp').style.display=node.help?'block':'none';
  const ans=el('answers'); ans.innerHTML='';
  /* Alleen categorieën die bewust nog niet gepubliceerd worden krijgen een banner.
     Vooruitlopend gepubliceerde categorieën niet — die zouden de tool onbruikbaar maken. */
  if(cat.regime==='voorbereiding' && cat.regimeNoot && state.history.length===0){
    const w=document.createElement('div'); w.className='not-doing';
    w.innerHTML=subst(`<strong>Dit publiceren we nu nog niet</strong>${cat.regimeNoot}`);
    ans.appendChild(w);
  }
  node.opties.forEach((opt,i)=>{
    ans.appendChild(buildOptionButton(opt.label, i, false, ()=>choose(opt)));
  });
  ans.appendChild(buildOptionButton('Ik weet het niet — wat nu?', 0, true, ()=>showWeetNiet('vraag')));
  el('backBtn').style.display = state.history.length? '':'none';
  renderTrail();
  announce('Vraag: '+plat(node.vraag));
  focusKop('qText');
}

/* Bouwt de doorlopen route. Stappen die via een "geen van bovenstaande"-lus
   terugkeren naar een eerder bezochte vraag worden gemarkeerd als 'verkend',
   zodat de verantwoording niet volloopt met herhaalde thema-vragen. */
function buildTrail(){
  const cat=CATEGORIES[state.catKey]; if(!cat) return [];
  const rows = state.history.map((h,i)=>{
    const node=cat.nodes[h.nodeKey];
    const opt = node.opties.find(o=>o.label===h.label);
    return {nodeKey:h.nodeKey, vraag:node.vraag, antwoord:h.label, next:opt&&opt.next, verkend:false};
  });
  const gezien = [];
  rows.forEach((r,i)=>{
    if(r.next && gezien.indexOf(r.next)>=0){
      r.verkend = true;
      for(let j=i-1;j>=0;j--){ if(rows[j].nodeKey===r.next){ rows[j].verkend=true; break; } }
    }
    gezien.push(r.nodeKey);
  });
  return rows;
}
function renderTrail(){
  const t=el('trail'); t.innerHTML='';
  const rows=buildTrail();
  if(!rows.length){ t.style.display='none'; return; }
  t.style.display='block';
  rows.forEach(r=>{
    const d=document.createElement('div'); d.className='crumb';
    d.innerHTML=`${r.vraag} → <b>${esc(plat(r.antwoord))}</b>`;
    t.appendChild(d);
  });
}
function choose(opt){
  state.history.push({nodeKey:state.nodeKey, label:opt.label});
  if(opt.result){ state.lastResult=opt.result; renderResult(opt.result); show('result'); updateUrl(true); }
  else { state.nodeKey=opt.next; renderNode(); updateUrl(true); }
}
el('backBtn').addEventListener('click', ()=>{
  terug(()=>{
    const prev=state.history.pop();
    if(prev){ state.nodeKey=prev.nodeKey; state.lastResult=null; renderNode(); updateUrl(); }
  });
});
el('restartBtn').addEventListener('click', ()=>{ renderCatGrid(); show('cat'); updateUrl(true); focusKop('catHeading'); });
el('resultBackBtn').addEventListener('click', ()=>{
  terug(()=>{
    state.lastResult=null; document.body.classList.remove('has-result');
    const prev=state.history.pop();
    if(prev){ state.nodeKey=prev.nodeKey; renderNode(); show('flow'); updateUrl(); }
    else { hardReset(); show('intro'); }
  });
});
/* Beide "opnieuw"-knoppen gebruiken dezelfde reset-routine (v6b.1 liet bij
   "Terug naar begin" de oude staat én de oude querystring staan). */
el('againBtn').addEventListener('click', ()=>{ hardReset(); show('intro'); });
document.querySelectorAll('.home-btn').forEach(b=>{
  b.addEventListener('click', ()=>{ hardReset(); show('intro'); });
});

/* ---- Extra resultaat-acties ---- */
/* Klap de verantwoording uit vóór het printen: sommige browsers negeren
   verborgen <details>-inhoud in print, ook met CSS. */
let trailStondOpen = false;
function trailOpenVoorPrint(){
  const d = document.querySelector('.trail-block'); if(!d) return;
  trailStondOpen = d.open; d.open = true;
}
window.addEventListener('beforeprint', trailOpenVoorPrint);
window.addEventListener('afterprint', ()=>{
  const d = document.querySelector('.trail-block');
  if(d && !trailStondOpen) d.open = false;      /* scherm weer opruimen na het printen */
});
el('printBtn').addEventListener('click', ()=>{ trailOpenVoorPrint(); window.print(); });
/* De feedbackknop blijft verborgen zolang er geen ontvanger is geconfigureerd
   (v6b.1 opende een mailto zonder geadresseerde). */
if(GEMEENTE.woocoordinator){
  el('feedbackBtn').classList.remove('hidden');
  el('feedbackBtn').addEventListener('click', ()=>{
    const cat=CATEGORIES[state.catKey]; if(!cat) return;
    const trail = buildTrail().map(r=>`- ${plat(r.vraag)} → ${plat(r.antwoord)}${r.verkend?'  [verkend, geen match]':''}`).join('\n');
    const body = `Ik heb de Woo-wegwijzer doorlopen en denk dat de uitkomst niet klopt.\n\nCategorie: ${plat(cat.naam)} (art. ${cat.art})\nUitkomst: ${state.lastResult||'(onbekend)'}\nToolversie: ${TOOL.versie}\n\nDoorlopen vragen:\n${trail}\n\nLink naar mijn doorloop:\n${location.href}\n\nMijn toelichting:\n\n`;
    const subject = `Feedback Woo-wegwijzer — ${plat(cat.naam)}`;
    location.href = `mailto:${encodeURIComponent(GEMEENTE.woocoordinator)}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });
}

/* ---- Result ---- */
const VERDICT_LABELS = {
  'ja':'Actief openbaar maken',
  'nee':'Niet onder deze categorie',
  'deels':'Andere categorie van toepassing',
  'ja-elders':'Al openbaar via een ander regime'
};

function renderResult(resKey){
  const cat=CATEGORIES[state.catKey];
  const r=cat.results[resKey];
  let html='';
  /* Haalt tussen-haakjes-artikelverwijzingen uit de lopende tekst en verzamelt ze,
     zodat ze in het uitklapje "Juridische onderbouwing" terechtkomen i.p.v. in het
     gezicht van de beleidsmedewerker. Laat niet-juridische haakjes (dagtekening, bv. …) staan. */
  const _refs=[];
  const ontjur = t => {
    if(!t) return t;
    let out = String(t).replace(/\s*\(([^()]*?\bart\.\s[^()]*?)\)/g, (m,inner)=>{ _refs.push(inner.trim()); return ''; });
    return out.replace(/\s+([.,;:])/g,'$1').replace(/\s{2,}/g,' ').trim();
  };

  /* Categorie die bewust nog niet gepubliceerd wordt (2k) */
  if(cat.regime==='voorbereiding' && cat.regimeNoot){
    html+=`<div class="not-doing"><strong>Dit publiceren we nu nog niet</strong>${cat.regimeNoot}</div>`;
  }

  const label = r.label || VERDICT_LABELS[r.status] || '';
  html+=`<div class="verdict ${r.status}">
    <div class="label">${esc(label)}</div>
    <h3>${ontjur(r.kop)}</h3><p>${ontjur(r.uitleg)}</p></div>`;

  if(r.wie && r.wie!=='—') html+=`<div class="detail-block"><h4>Wie maakt wat openbaar</h4><p>${ontjur(r.wie)}</p></div>`;
  if(r.termijn && r.termijn!=='—'){
    html+=`<div class="detail-block"><h4>Publicatietermijn</h4><p>${ontjur(r.termijn)}</p></div>`;
  }
  if(r.tip) html+=`<div class="detail-block"><h4>Let op</h4><p>${ontjur(r.tip)}</p></div>`;

  /* Concreet handelingsperspectief bij een 'ja'. Een 'ja-elders' krijgt géén
     actielijst: die uitkomst zegt juist dat er geen aparte actie nodig is. */
  if(r.status==='ja'){
    const acties = BASE_ACTIES.concat(r.acties||[]);
    html+=`<div class="detail-block action-block"><h4>Wat moet je nu doen</h4><ol class="action-list">`;
    acties.forEach(a=>{ html+=`<li>${ontjur(a)}</li>`; });
    html+=`</ol></div>`;
  }

  /* Doorverwijzing naar een andere categorie */
  if(r.ander){
    const ac = CATEGORIES[r.ander];
    html+=`<div class="detail-block"><h4>Volgende stap</h4><p>Dit stuk hoort mogelijk bij categorie ${ac?('<b>'+esc(ac.naam)+'</b>'):esc(r.ander)}.</p>`;
    if(ac) html+=`<button type="button" class="btn-ghost" data-ander="${esc(r.ander)}" style="margin-top:8px;">Doorloop categorie ${esc(ac.naam)} <span aria-hidden="true">→</span></button>`;
    html+=`</div>`;
  }

  /* VERANTWOORDING — de doorlopen vragen. Stond in v6b.1 wel beloofd in de
     "Ik weet het niet"-uitleg, maar werd nergens gerenderd (en ontbrak dus ook in de PDF). */
  const rows = buildTrail();
  if(rows.length){
    const aantal = rows.filter(x=>!x.verkend).length;
    html+=`<details class="detail-block trail-block"><summary>Je antwoorden (${aantal}) — voor {JZ}, staat altijd in de PDF</summary><div class="trail-inner">`;
    rows.filter(x=>!x.verkend).forEach(r2=>{
      html+=`<div class="crumb">${r2.vraag} → <b>${esc(plat(r2.antwoord))}</b></div>`;
    });
    const verkend = rows.filter(x=>x.verkend && x.antwoord);
    if(verkend.length){
      const namen = [...new Set(verkend.map(v=>plat(v.antwoord)))].filter(v=>!/geen van/i.test(v));
      if(namen.length) html+=`<div class="verkend">Eerst verkend, geen match: ${esc(namen.join(' · '))}</div>`;
    }
    html+=`<p class="trail-meta">Categorie ${esc(cat.art)} · toolversie ${esc(TOOL.versie)} · doorlopen op ${new Date().toLocaleDateString('nl-NL',{day:'numeric',month:'long',year:'numeric'})}</p></div></details>`;
  }

  /* Juridische onderbouwing — alle artikelnummers, grondslag en bron gebundeld en uit
     de lopende tekst gehaald. Klopbaar voor de jurist/DMS, uit het zicht van de gebruiker. */
  const ooPath = 'onderwerpen/openbaar-maken/woo-informatiecategorieen-en-definities';
  const grondslag = esc(cat.artLang || ('artikel 3.3 Woo, categorie '+cat.art));
  const bepalingen = [...new Set(_refs)];
  const caveat = cat.grounding==='vol' ? '' : 'Gebaseerd op de officiële samenvatting; verifieer twijfelgevallen tegen de volledige werkdefinitie. ';
  html+=`<details class="detail-block jur-block"><summary>Juridische onderbouwing</summary><div class="jur-inner">`+
        `<p><b>Grondslag:</b> categorie ${esc(cat.art)} — ${grondslag}.</p>`+
        (bepalingen.length?`<p><b>Genoemde bepalingen:</b> ${esc(bepalingen.join('; '))}.</p>`:'')+
        `<p class="werkdef-stamp">${caveat}Bron: ${esc(cat.bron)}. Officiële bron: <a href="https://www.open-overheid.nl/${ooPath}" target="_blank" rel="noopener">open-overheid.nl</a>.</p>`+
        `</div></details>`;

  el('resultBody').innerHTML=subst(html);

  /* Geen inline onclick meer: werkt ook onder een strikte Content-Security-Policy. */
  const doorBtn = el('resultBody').querySelector('[data-ander]');
  if(doorBtn) doorBtn.addEventListener('click', ()=>startCategory(doorBtn.dataset.ander));

  document.body.classList.add('has-result');
  /* Korte samenvatting i.p.v. het hele scherm voorlezen. */
  announce(`Uitkomst: ${plat(r.kop)}. Categorie ${cat.art}, ${plat(cat.naam)}.`);
  focusKop('resultHeading');
}

/* ============================================================
   OPSTARTEN + ZELFTEST
   ============================================================ */
function vulConfigTeksten(){
  const org = GEMEENTE.naam || 'deze organisatie';
  el('regimeFooter').innerHTML =
    `<b>Over de status van de verplichting.</b> De verplichte actieve openbaarmaking van art. 3.3 Woo treedt gefaseerd in werking bij Koninklijk Besluit. Peildatum ${esc(TOOL.bronpeildatum)}: van de categorieën in deze wegwijzer is alleen 1b (overige besluiten van algemene strekking) wettelijk verplicht, als onderdeel van de eerste tranche die op 1 november 2024 in werking is getreden. De overige categorieën worden hier gepresenteerd als geldend omdat ${esc(org.toLowerCase()==='deze organisatie'?'de organisatie':org)} ze vooruitlopend toepast op grond van art. 3.1 Woo. Dat is een bestuurlijke keuze, geen wettelijke plicht; de genoemde termijnen zijn tot inwerkingtreding een werknorm. Categorie 2k (beschikkingen) is hiervan uitgezonderd.`;
  el('versieStamp').innerHTML =
    `Toolversie ${TOOL.versie} · inhoud laatst gecontroleerd tegen de bronnen op ${TOOL.gecontroleerd} · status inwerkingtreding naar de stand van ${TOOL.bronpeildatum}.<br>`+
    `Gebaseerd op de officiële werkdefinities en handreikingen van <a href="https://www.open-overheid.nl/onderwerpen/openbaar-maken/woo-informatiecategorieen-en-definities" target="_blank" rel="noopener">open-overheid.nl — Woo-informatiecategorieën en definities</a>. Die werkdefinities zijn in ontwikkeling: controleer bij twijfel daar de actuele versie.`;
}

/* Goedkope verzekering nu de datastructuur groeit: waarschuwt in de console
   zodra een verwijzing niet meer bestaat. Zichtbaar via F12 → Console. */
function zelftest(){
  const err=[];
  for(const [nk,node] of Object.entries(TRIAGE.nodes))
    for(const o of node.opties){
      if(o.next && !TRIAGE.nodes[o.next]) err.push(`TRIAGE ${nk}: next "${o.next}" bestaat niet`);
      if(o.cat && !CATEGORIES[o.cat]) err.push(`TRIAGE ${nk}: cat "${o.cat}" bestaat niet`);
      if(o.cat && o.node && CATEGORIES[o.cat] && !CATEGORIES[o.cat].nodes[o.node]) err.push(`TRIAGE ${nk}: node "${o.node}" bestaat niet in ${o.cat}`);
      if(o.result && !(o.cat && CATEGORIES[o.cat] && CATEGORIES[o.cat].results[o.result])) err.push(`TRIAGE ${nk}: result "${o.result}" bestaat niet`);
    }
  for(const [ck,c] of Object.entries(CATEGORIES)){
    if(!c.nodes[c.start]) err.push(`${ck}: startnode "${c.start}" bestaat niet`);
    if(!c.regime || !REGIMES[c.regime]) err.push(`${ck}: onbekend regime "${c.regime}"`);
    if(!c.artLang) err.push(`${ck}: artLang ontbreekt`);
    if(CAT_VOLGORDE.indexOf(ck)<0) err.push(`${ck}: ontbreekt in CAT_VOLGORDE`);
    const bereikt=new Set([c.start]), gebruikt=new Set();
    for(const [nk,node] of Object.entries(c.nodes)){
      const labels=node.opties.map(o=>o.label);
      labels.forEach((l,i)=>{ if(labels.indexOf(l)!==i) err.push(`${ck}.${nk}: dubbel antwoordlabel "${l}" (breekt de deellink)`); });
      for(const o of node.opties){
        if(o.next){ if(!c.nodes[o.next]) err.push(`${ck}.${nk}: next "${o.next}" bestaat niet`); else bereikt.add(o.next); }
        if(o.result){ if(!c.results[o.result]) err.push(`${ck}.${nk}: result "${o.result}" bestaat niet`); else gebruikt.add(o.result); }
        if(!o.next && !o.result) err.push(`${ck}.${nk}: optie "${o.label}" heeft geen bestemming`);
      }
    }
    for(const nk of Object.keys(c.nodes)) if(!bereikt.has(nk)) err.push(`${ck}: node "${nk}" is onbereikbaar`);
    for(const [rk,r] of Object.entries(c.results)){
      if(!gebruikt.has(rk)) err.push(`${ck}: result "${rk}" is onbereikbaar`);
      if(r.ander && !CATEGORIES[r.ander]) err.push(`${ck}.${rk}: ander "${r.ander}" bestaat niet`);
      if(!VERDICT_LABELS[r.status]) err.push(`${ck}.${rk}: onbekende status "${r.status}"`);
    }
  }
  const _log = (typeof console!=='undefined' && console.log) ? console.log.bind(console) : function(){};
  if(err.length) _log('[Woo-wegwijzer] zelftest: '+err.length+' probleem(en)\n'+err.join('\n'));
  else _log('[Woo-wegwijzer] zelftest OK — '+Object.keys(CATEGORIES).length+' categorieën, versie '+TOOL.versie);
  return err;
}

vulConfigTeksten();
zelftest();
if(!loadFromUrl()) show('intro');
</script>

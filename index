/* ============================================================
   ENGINE
   ============================================================ */
const state = { catKey:null, nodeKey:null, history:[], triageHistory:[], triageNode:null, lastResult:null, screen:'intro' };
const el = id => document.getElementById(id);
const screens = {intro:el('screen-intro'), triage:el('screen-triage'), cat:el('screen-cat'), flow:el('screen-flow'), result:el('screen-result')};
const reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
const esc = s => String(s).replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const JZ = (typeof GEMEENTE!=='undefined' && GEMEENTE.juridischeZaken) ? GEMEENTE.juridischeZaken : 'een collega van Juridische Zaken';
const subst = s => String(s).replace(/\{JZ\}/g, JZ);
const plat = s => String(s).replace(/<[^>]+>/g,'');

/* Voorkomt dat het herstellen van een URL zelf weer een history-entry pusht. */
let herstelBezig = false;
/* Aantal history-entries dat deze tool zelf heeft toegevoegd. Voorkomt dat een
   in-app "vorige"-knop de gebruiker de tool uit stuurt bij een gedeelde link. */
let pushCount = 0;

/* show() regelt alleen zichtbaarheid; de URL wordt expliciet bijgewerkt door de
   navigatiefuncties, zodat elke voorwaartse stap een échte history-entry krijgt. */
function show(name){
  state.screen = name;
  Object.values(screens).forEach(s=>s.classList.add('hidden'));
  screens[name].classList.remove('hidden');
  document.body.classList.toggle('has-result', name==='result' && !!state.lastResult);
  window.scrollTo({top:0, behavior: reduceMotion?'auto':'smooth'});
}

/* Eén stap terug: gebruik de echte browserhistorie als die van ons is,
   anders val terug op de interne stapel. */
function terug(fallback){
  if(pushCount>0){ history.back(); return; }
  fallback();
}

/* ---- Accessibility live-announce ---- */
function announce(msg){
  const a = el('a11y-announce'); if(!a) return;
  a.textContent=''; setTimeout(()=>{ a.textContent=msg; }, 60);
}

/* WCAG 2.4.3: na elke schermwissel de focus naar de kop van het nieuwe scherm,
   zodat toetsenbord- en screenreadergebruikers niet steeds vanaf de top beginnen. */
function focusKop(id){
  const h = el(id); if(!h) return;
  setTimeout(()=>{ try{ h.focus({preventScroll:true}); }catch(_){ h.focus(); } }, 30);
}

/* ---- Toast ---- */
function toast(msg){
  const t=el('toast'); t.textContent=msg; t.classList.add('show');
  setTimeout(()=>t.classList.remove('show'), 2400);
}

/* ---- URL sharing: encode/decode state ----
   Alle history-aanroepen zitten in try/catch: in een sandboxed iframe (opaque origin)
   gooit de browser een SecurityError. De tool moet dan gewoon blijven werken, alleen
   zonder deelbare link. */
function bouwQuery(){
  const p=new URLSearchParams();
  if(state.catKey){
    p.set('c', state.catKey);
    if(state.history.length){
      const trail=state.history.map(h=>{
        const cat=CATEGORIES[state.catKey]; const node=cat.nodes[h.nodeKey];
        const idx = node.opties.findIndex(o=>o.label===h.label);
        return h.nodeKey+':'+(idx>=0?idx:'');
      }).join(',');
      p.set('t', trail);
    }
    if(state.lastResult) p.set('r', state.lastResult);
  }
  const q=p.toString();
  return q ? ('?'+q) : location.pathname;
}
function updateUrl(push){
  if(herstelBezig) return;
  const url = bouwQuery();
  try{
    if(push){ history.pushState(null,'',url); pushCount++; }
    else history.replaceState(null,'',url);
  }catch(_){ /* opaque origin of oudere browser: deellink degradeert, tool werkt door */ }
}
function loadFromUrl(){
  let p;
  try{ p=new URLSearchParams(location.search); }catch(_){ return false; }
  const c=p.get('c'); if(!c || !CATEGORIES[c]) return false;
  const cat=CATEGORIES[c]; state.catKey=c; state.history=[]; state.nodeKey=cat.start; state.lastResult=null;
  const trail=(p.get('t')||'').split(',').filter(Boolean);
  for(const seg of trail){
    const [nk,idxStr] = seg.split(':'); const node = cat.nodes[nk]; if(!node) break;
    const idx = parseInt(idxStr,10); const opt = node.opties[idx]; if(!opt) break;
    state.history.push({nodeKey:nk, label:opt.label});
    if(opt.next) state.nodeKey=opt.next;
    if(opt.result){ state.lastResult=opt.result; renderResult(opt.result); show('result'); return true; }
  }
  const r=p.get('r');
  if(r && cat.results[r]){ state.lastResult=r; renderResult(r); show('result'); return true; }
  renderNode(); show('flow'); return true;
}

/* Browser-terugknop: herstel de staat uit de URL in plaats van de tool te verlaten. */
window.addEventListener('popstate', ()=>{
  herstelBezig = true;
  pushCount = Math.max(0, pushCount-1);
  try{
    if(!loadFromUrl()){ hardReset(false); show('intro'); }
  } finally { herstelBezig = false; }
});

/* ---- Eén reset-routine voor alle "opnieuw"-knoppen ---- */
function hardReset(schrijfUrl){
  state.catKey=null; state.nodeKey=null; state.history=[]; state.triageHistory=[];
  state.triageNode=null; state.lastResult=null;
  document.body.classList.remove('has-result');
  if(schrijfUrl!==false){
    try{ history.pushState(null,'',location.pathname); pushCount++; }catch(_){}
  }
}


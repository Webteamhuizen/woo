<!DOCTYPE html>
<html lang="nl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="Wegwijzer die stap voor stap bepaalt of een document onder de actieve openbaarmakingsplicht van de Wet open overheid valt, en onder welke informatiecategorie.">
<meta name="robots" content="noindex, nofollow">
<title>Woo-wegwijzer — Gemeente Huizen</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%23003478'/%3E%3Cpath d='M9 16.5l4.5 4.5L23 11.5' stroke='%23fff' stroke-width='3' fill='none' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E">
<style>
  :root{
    /* Huisstijl gemeente Huizen (basis: Native cheat sheet apr 2026) */
    --navy:#003478; --navy-soft:#8FC6EC; --navy-tint:#E3F1FA;   /* Huizen: PMS 541 C */
    --ink:#1C232E; --ink-soft:#5F5C5A;              /* darker gray voor WCAG-contrast op wit */
    --paper:#FFFFFF; --canvas:#F5F5F3; --line:#DEDDDC;
    --teal:#003478; --teal-soft:#E3F1FA;             /* primair accent = Huizen donkerblauw */
    --amber:#7A5510; --amber-soft:#F4E5C2;           /* WCAG 1.4.3: 5,4:1 op amber-soft (was #8F6614 = 4,1:1) */
    --red:#8F2E37; --red-soft:#F4DDDB;               /* donkerder rood voor tekst-contrast */
    --green:#2E6A3A; --green-soft:#DFF0E4; --accent-green:#5BB885;   /* accent-green alleen decoratief: 2,4:1 met wit, dus niet achter tekst */
    --focus:#FFB300;                                  /* amber gloed; altijd samen met de donkere binnenring (zie :focus-visible) */
    --display:Arial,Helvetica,sans-serif;
    --body:Arial,Helvetica,sans-serif;
    --mono:'Courier New',Courier,monospace;
  }
  *{box-sizing:border-box;}
  body{margin:0;background:var(--canvas);color:var(--ink);font-family:var(--body);line-height:1.5;}
  .app{max-width:780px;margin:0 auto;padding:20px 20px 60px;}

  header.top{background:var(--navy);color:#fff;padding:16px 20px 18px;}
  header.top .inner{max-width:780px;margin:0 auto;display:flex;gap:18px;align-items:center;}
  header.top .brand-logo{flex-shrink:0;height:48px;width:auto;background:#fff;padding:9px 14px;border-radius:8px;box-shadow:0 1px 4px rgba(0,0,0,.15);}
  header.top .header-text{flex:1;min-width:0;}
  header.top .eyebrow{font-family:var(--mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--navy-soft);margin-bottom:4px;}
  header.top h1{font-family:var(--display);font-weight:700;font-size:24px;margin:0 0 4px;letter-spacing:-.3px;line-height:1.15;}
  header.top p{max-width:560px;color:#EAF0F7;margin:0;font-size:13.5px;line-height:1.45;}
  @media (max-width:560px){
    header.top .inner{flex-direction:column;align-items:flex-start;gap:12px;}
    header.top .brand-logo{height:40px;padding:7px 11px;}
    header.top h1{font-size:22px;}
  }

  /* ------- WCAG: focus, sr-only, reduced-motion ------- */
  /* Dubbele ring (WCAG 1.4.11): donkere binnenring werkt op lichte vlakken,
     amber buitenring op donkere vlakken. Losse amber ring haalde maar 1,6:1 op --canvas. */
  *:focus{outline:none;}
  *:focus-visible{outline:3px solid var(--ink);outline-offset:2px;box-shadow:0 0 0 6px var(--focus);border-radius:3px;}
  header.top *:focus-visible{outline-color:#fff;}
  .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;}
  .skip-link{position:absolute;left:-9999px;top:0;z-index:300;background:var(--navy);color:#fff;padding:10px 16px;border-radius:0 0 6px 0;font-family:var(--body);font-size:14px;text-decoration:none;}
  .skip-link:focus{left:0;}
  @media (prefers-reduced-motion: reduce){
    *{animation-duration:0.01ms !important;animation-iteration-count:1 !important;transition-duration:0.01ms !important;scroll-behavior:auto !important;}
  }

  /* ------- Prominent "wat deze tool niet doet" waarschuwingsblok ------- */
  .not-doing{
    border-left:4px solid var(--amber);background:var(--amber-soft);
    padding:14px 16px;margin:20px 0;border-radius:4px;font-size:13.5px;color:var(--ink);
  }
  .not-doing strong{color:var(--amber);display:block;margin-bottom:4px;font-family:var(--display);}

  /* ------- Tooltip / afkortingen ------- */
  abbr[title]{border-bottom:1px dotted var(--ink-soft);cursor:help;text-decoration:none;}

  /* ------- Extra actieknoppen op resultaat ------- */
  .result-actions{margin-top:22px;padding-top:16px;border-top:1px dashed var(--line);display:flex;flex-wrap:wrap;gap:10px;}
  .result-actions .btn-tool{
    display:inline-flex;align-items:center;gap:6px;
    border:1px solid var(--navy);background:#fff;color:var(--navy);
    border-radius:8px;padding:8px 14px;font-family:var(--body);font-size:13px;cursor:pointer;
    font-weight:700;
  }
  .result-actions .btn-tool:hover{background:var(--navy);color:#fff;}
  /* .hidden verliest het anders van de specifiekere .result-actions .btn-tool regel */
  .result-actions .btn-tool.hidden{display:none;}

  /* ------- Weet-niet knop ------- */
  .answer.weet-niet{background:#FAF7EF;border-style:dashed;color:var(--ink-soft);}
  .answer.weet-niet .key{color:var(--amber);border-color:var(--amber);}

  /* ------- Werkdefinitie-versiestempel ------- */
  .werkdef-stamp{font-family:var(--mono);font-size:11px;color:var(--ink-soft);margin-top:6px;display:block;}

  /* ------- Deelbare-link melding ------- */
  .toast{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);background:var(--navy);color:#fff;padding:10px 18px;border-radius:6px;font-size:13px;box-shadow:0 4px 12px rgba(0,0,0,.2);opacity:0;transition:opacity .2s;pointer-events:none;z-index:100;}
  .toast.show{opacity:1;}

  /* ------- Print stylesheet ------- */
  @media print{
    body{background:#fff;color:#000;}
    header.top{background:#fff;color:#000;padding:0 0 20px;border-bottom:2px solid #000;}
    header.top .eyebrow,header.top h1,header.top p{color:#000 !important;}
    /* Logo is wit gemaakt voor de navy header; op papier moet het filter eraf. */
    header.top .brand-logo{filter:none !important;}
    .app{max-width:100%;padding:20px 0;}
    .skip-link{display:none !important;}
    /* Alleen als er een uitkomst is, dwingen we het resultaatscherm af.
       Anders print de browser gewoon het scherm dat de gebruiker ziet. */
    body.has-result main section{display:none !important;}
    body.has-result #screen-result{display:block !important;}
    .nav-row,.result-actions,.btn-ghost,.home-btn,.btn-primary,.btn-tool,.answers{display:none !important;}
    .card{border:none;padding:0;}
    /* De verantwoording hoort altijd in de PDF, ook als hij op het scherm dicht stond. */
    .trail-block,.jur-block{page-break-inside:avoid;}
    .trail-block > summary,.jur-block > summary{display:none;}
    .trail-block .trail-inner,.jur-block .jur-inner{display:block !important;}
    footer{page-break-inside:avoid;}
    footer .disc-more[open] p{display:block;}
    a{color:#000;text-decoration:underline;}
    a[href^="http"]::after{content:" (" attr(href) ")";font-size:10px;word-break:break-all;}
  }

  section{margin-top:0;}
  .card{background:var(--paper);border:1px solid var(--line);border-radius:10px;padding:20px 22px;}
  h2.section-title{font-family:var(--mono);font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--teal);margin:0 0 16px;}

  /* Intro */
  .intro-lead{font-family:var(--display);font-weight:700;font-size:19px;line-height:1.35;color:var(--ink);margin:0 0 12px;}
  .intro-body p{font-size:14.5px;color:var(--ink-soft);margin:0 0 12px;}
  .intro-points{list-style:none;padding:0;margin:16px 0 4px;}
  .intro-points li{display:flex;gap:11px;align-items:flex-start;font-size:14px;color:var(--ink-soft);margin-bottom:10px;}
  .intro-points .ic{flex-shrink:0;width:22px;height:22px;border-radius:6px;background:var(--teal-soft);color:var(--teal);display:flex;align-items:center;justify-content:center;font-family:var(--mono);font-size:12px;font-weight:600;}
  .reassure{background:var(--teal-soft);border-radius:8px;padding:13px 16px;font-size:13.5px;color:var(--ink-soft);margin:18px 0 4px;}

  .btn-primary{
    margin-top:20px;background:var(--navy);color:#fff;border:none;padding:14px 26px;border-radius:8px;
    font-family:var(--body);font-weight:700;font-size:14.5px;cursor:pointer;letter-spacing:.2px;
  }
  .btn-primary:hover{background:#002348;}

  .cat-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:10px;}
  .cat{
    text-align:left;border:1px solid var(--line);border-radius:9px;padding:13px 15px;background:#fff;
    cursor:pointer;font-family:var(--body);transition:.12s border-color,.12s transform;position:relative;
  }
  .cat:hover{border-color:var(--teal);transform:translateY(-1px);}
  .cat .art{font-family:var(--mono);font-size:11px;color:var(--teal);}
  .cat .naam{display:block;font-weight:600;font-size:14px;margin-top:3px;color:var(--ink);line-height:1.3;}
  /* WCAG 1.4.1: gevuld vs. open stip, zodat kleur niet het enige onderscheid is. */
  .g-dot{position:absolute;top:13px;right:13px;width:10px;height:10px;border-radius:50%;box-sizing:border-box;}
  .g-dot.vol{background:var(--green);border:2px solid var(--green);}
  .g-dot.samenvatting{background:#fff;border:2px solid var(--amber);}

  .legend{display:flex;gap:18px;flex-wrap:wrap;margin-top:16px;font-size:12px;color:var(--ink-soft);}
  .legend span{display:inline-flex;align-items:center;gap:6px;}
  .legend .dot{width:10px;height:10px;border-radius:50%;box-sizing:border-box;flex-shrink:0;}
  .legend .dot.vol{background:var(--green);border:2px solid var(--green);}
  .legend .dot.samenvatting{background:#fff;border:2px solid var(--amber);}

  .progress{font-family:var(--mono);font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--ink-soft);margin-bottom:14px;}
  .q-text{font-family:var(--display);font-size:21px;line-height:1.35;margin:0 0 6px;font-weight:600;}
  .q-help{font-size:13.5px;color:var(--ink-soft);margin:0 0 18px;}
  .answers{display:flex;flex-direction:column;gap:9px;}
  .answer{
    text-align:left;border:1px solid var(--line);border-radius:9px;padding:13px 16px;background:#fff;
    cursor:pointer;font-family:var(--body);font-size:14.5px;color:var(--ink);transition:.12s;
    display:flex;align-items:center;gap:11px;
  }
  .answer:hover{border-color:var(--teal);background:var(--teal-soft);}
  .answer .key{font-family:var(--mono);font-size:12px;color:var(--teal);border:1px solid var(--teal);border-radius:5px;width:22px;height:22px;display:flex;align-items:center;justify-content:center;flex-shrink:0;}

  .trail{margin-top:20px;padding-top:16px;border-top:1px solid var(--line);}
  .trail .crumb{font-size:12.5px;color:var(--ink-soft);margin-bottom:5px;}
  .trail .crumb b{color:var(--ink);font-weight:600;}
  .nav-row{margin-top:18px;display:flex;gap:10px;flex-wrap:wrap;}
  .btn-ghost{border:1px solid var(--line);background:#fff;color:var(--ink-soft);border-radius:8px;padding:9px 16px;font-family:var(--body);font-size:13.5px;cursor:pointer;}
  .btn-ghost:hover{border-color:var(--ink-soft);}

  .verdict{border-radius:10px;padding:18px 20px;margin-bottom:18px;}
  .verdict.ja{background:var(--green-soft);border:1px solid #BFDAC5;}
  .verdict.nee{background:var(--red-soft);border:1px solid #E3B7B1;}
  .verdict.deels{background:var(--amber-soft);border:1px solid #E8CE9A;}
  .verdict.ja-elders{background:var(--teal-soft);border:1px solid var(--navy-soft);}
  .verdict .label{font-family:var(--mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;margin-bottom:6px;}
  .verdict.ja .label{color:var(--green);} .verdict.nee .label{color:var(--red);}
  .verdict.deels .label{color:var(--amber);} .verdict.ja-elders .label{color:var(--navy);}
  .verdict h3{font-family:var(--display);font-size:22px;margin:0 0 8px;font-weight:600;}
  .verdict p{margin:0;font-size:14.5px;color:var(--ink-soft);}

  .detail-block{border:1px solid var(--line);border-radius:9px;padding:16px 18px;margin-bottom:12px;background:#fff;}
  .detail-block h4{font-family:var(--mono);font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--teal);margin:0 0 8px;}
  .detail-block p{margin:0 0 6px;font-size:14px;color:var(--ink-soft);}
  .detail-block p:last-child{margin-bottom:0;}
  .action-block{border:1px solid #BFDAC5;background:var(--green-soft);}
  .action-block h4{color:var(--green);}
  .action-list{margin:0;padding:0;list-style:none;counter-reset:step;}
  .action-list li{position:relative;padding:9px 0 9px 34px;font-size:14px;color:var(--ink-soft);border-bottom:1px solid rgba(62,122,76,.18);}
  .action-list li:last-child{border-bottom:none;}
  /* --green i.p.v. --accent-green: wit op #5BB885 haalde 2,4:1 (WCAG 1.4.3 faalt). */
  .action-list li::before{counter-increment:step;content:counter(step);position:absolute;left:0;top:9px;width:22px;height:22px;background:var(--green);color:#fff;border-radius:50%;font-family:var(--display);font-weight:700;font-size:12px;display:flex;align-items:center;justify-content:center;}

  .grounding-note{border-radius:8px;padding:11px 14px;font-size:12.5px;margin-bottom:16px;}
  .grounding-note.vol{background:var(--green-soft);color:var(--green);}
  .grounding-note.samenvatting{background:var(--amber-soft);color:var(--amber);}

  /* Regime-regel: vooruitlopend publiceren op grond van art. 3.1 Woo. */
  .regime-note{border-left:3px solid var(--navy-soft);background:var(--teal-soft);padding:9px 13px;border-radius:0 6px 6px 0;font-size:12.5px;color:var(--ink);margin-top:8px;}
  .regime-note b{font-family:var(--display);}

  /* Verantwoordingsblok: op het scherm ingeklapt (de medewerker heeft de vragen
     net zelf beantwoord), in de PDF altijd uitgeklapt voor Juridische Zaken. */
  .jur-block{padding:0;margin-top:0;}
  .jur-block > summary{cursor:pointer;list-style:none;padding:12px 18px;font-family:var(--mono);font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--teal);user-select:none;}
  .jur-block > summary::-webkit-details-marker{display:none;}
  .jur-block > summary::before{content:'▸ ';}
  .jur-block[open] > summary::before{content:'▾ ';}
  .jur-block > summary:hover{color:var(--navy);}
  .jur-block .jur-inner{padding:0 18px 14px;font-size:13px;color:var(--ink-soft);}
  .jur-block .jur-inner p{margin:6px 0;}
  .jur-block .jur-inner b{color:var(--ink);}
  .trail-block{padding:0;}
  .trail-block > summary{cursor:pointer;list-style:none;padding:12px 18px;font-family:var(--mono);font-size:11px;
    letter-spacing:.06em;text-transform:uppercase;color:var(--teal);user-select:none;}
  .trail-block > summary::-webkit-details-marker{display:none;}
  .trail-block > summary::before{content:'▸ ';}
  .trail-block[open] > summary::before{content:'▾ ';}
  .trail-block > summary:hover{color:var(--navy);}
  .trail-block .trail-inner{padding:0 18px 14px;}
  .trail-block .crumb{font-size:13px;color:var(--ink-soft);padding:6px 0;border-bottom:1px solid var(--line);}
  .trail-block .crumb:last-child{border-bottom:none;}
  .trail-block .crumb b{color:var(--ink);font-weight:600;}
  .trail-block .verkend{font-size:12.5px;color:var(--ink-soft);font-style:italic;padding:6px 0;border-bottom:1px solid var(--line);}
  .trail-meta{font-family:var(--mono);font-size:11px;color:var(--ink-soft);margin-top:10px;}

  /* --ink-soft i.p.v. #8A8F98: 3,3:1 was te laag voor 12px-tekst. */
  .src-note{font-size:12px;color:var(--ink-soft);margin-top:12px;font-style:italic;}
  footer{margin-top:36px;padding-top:16px;border-top:1px solid var(--line);font-size:12.5px;color:var(--ink-soft);line-height:1.55;}
  footer strong{color:var(--ink);}
  footer a{color:var(--teal);text-decoration:underline;}
  footer a:hover{color:#002348;}
  footer .disc-more{margin-top:4px;}
  footer .disc-more summary{cursor:pointer;color:var(--teal);font-weight:700;padding:4px 0;list-style:none;display:inline-block;user-select:none;}
  footer .disc-more summary::before{content:'▸ ';display:inline-block;transition:transform .15s;}
  footer .disc-more[open] summary::before{content:'▾ ';}
  footer .disc-more summary::-webkit-details-marker{display:none;}
  footer .disc-more p{margin:8px 0;}
  .hidden{display:none;}

  /* ------- Native <dialog>: regelt focus-trap, Escape en backdrop zelf (WCAG 2.4.3 / 4.1.2) ------- */
  dialog#weetNiet{border:none;border-radius:10px;padding:24px 26px;max-width:520px;width:calc(100% - 40px);
    font-family:var(--body);font-size:14.5px;line-height:1.55;color:var(--ink);background:#fff;box-shadow:0 10px 40px rgba(0,0,0,.25);}
  dialog#weetNiet::backdrop{background:rgba(0,0,0,.5);}
  dialog#weetNiet h2{font-family:var(--display);font-size:20px;margin:0 0 12px;font-weight:700;}
  dialog#weetNiet .dlg-body{margin:0 0 18px;}
  dialog#weetNiet ol{margin:10px 0 0;padding-left:20px;}
  dialog#weetNiet li{margin-bottom:8px;}

  /* Toetsenbord-hint bij de sneltoetsen A/B/C */
  .key-hint{font-size:12px;color:var(--ink-soft);margin:10px 0 0;}
  .answer .key{transition:none;}
</style>
</head>
<body>
<a class="skip-link" href="#mainContent">Naar de inhoud</a>

<header class="top">
  <div class="inner">
<img class="brand-logo" src="data:image/png;base64," alt="Gemeente Huizen" height="48">
    <div class="header-text">
    <div class="eyebrow">Woo · actieve openbaarmaking · concept</div>
    <h1>Woo-wegwijzer</h1>
    <p>Ontdek in een paar klikken of jouw document openbaar gaat. In gewone taal, geen juridische voorkennis nodig.</p>
    </div>
  </div>
</header>

<main class="app" id="mainContent">
<div id="a11y-announce" class="sr-only" aria-live="polite" aria-atomic="true"></div>

<noscript>
  <div class="not-doing" style="margin-top:0;">
    <strong>Deze wegwijzer heeft JavaScript nodig</strong>
    De vragen en uitkomsten worden door het bestand zelf berekend; daar is JavaScript voor nodig. Zet JavaScript aan in je browser, of neem contact op met een collega van Juridische Zaken voor een handmatige beoordeling.
  </div>
</noscript>

  <!-- SCREEN 0: INTRO / ONBOARDING -->
  <section id="screen-intro">
    <div class="card">
      <h2 class="section-title">Welkom</h2>
      <p class="intro-lead">Moet dit document actief openbaar worden gemaakt? Beantwoord een aantal vragen om dit te bepalen.</p>
      <div class="intro-body">
        <p>De gemeente maakt sommige documenten uit zichzelf openbaar. Deze hulp vertelt je of dat voor jóuw document geldt, en waarom.</p>
        <ul class="intro-points">
          <li><span class="ic">1</span><span>Je beantwoordt een paar korte vragen. Geen wetsartikelen nodig.</span></li>
          <li><span class="ic">2</span><span>Je hoort of het document openbaar gaat — en waarom.</span></li>
          <li><span class="ic">3</span><span>Zo ja: je krijgt een kort stappenplan.</span></li>
        </ul>
        <div class="reassure">Twijfel je? Geen probleem — je krijgt een onderbouwde indicatie. De knoop doorhakken doet een collega van Juridische Zaken.</div>
      </div>
      <button class="btn-primary" id="startBtn">Beginnen →</button>
    </div>
  </section>

  <!-- SCREEN 1: TRIAGE -->
  <section id="screen-triage" class="hidden">
    <div class="card">
      <div class="progress" id="triageProgress">Start</div>
      <h2 class="q-text" id="triageText" tabindex="-1"></h2>
      <p class="q-help" id="triageHelp"></p>
      <div class="answers" id="triageAnswers"></div>
      <p class="key-hint">Tip: je kunt ook de letter van een antwoord typen (A, B, C…).</p>
      <div class="nav-row">
        <button class="btn-ghost" id="triageBackBtn" type="button"><span aria-hidden="true">←</span> Vorige</button>
        <button class="btn-ghost" id="triageListBtn" type="button">Ik weet de categorie al <span aria-hidden="true">→</span></button>
        <button class="btn-ghost home-btn" type="button"><span aria-hidden="true">↺</span> Terug naar begin</button>
      </div>
    </div>
  </section>

  <!-- SCREEN 2: CATEGORY PICKER -->
  <section id="screen-cat" class="hidden">
    <div class="card">
      <h2 class="section-title" id="catHeading" tabindex="-1">Kies de categorie die je wilt checken</h2>
      <div id="catGridWrap"></div>
      <div class="legend">
        <span><span class="dot vol"></span> gebouwd op de volledige werkdefinitie</span>
        <span><span class="dot samenvatting"></span> gebouwd op de officiële samenvatting — verifieer tegen de volledige werkdefinitie</span>
      </div>
      <div class="nav-row"><button class="btn-ghost" id="catToTriageBtn" type="button"><span aria-hidden="true">←</span> Terug naar het begin</button></div>
    </div>
  </section>

  <!-- SCREEN 3: QUESTION FLOW -->
  <section id="screen-flow" class="hidden">
